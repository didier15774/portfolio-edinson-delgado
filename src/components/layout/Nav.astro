---
import { mainNavigation } from '@/data/navigation';
import { siteConfig } from '@/data/site';
import { isNavActive } from '@/lib/paths';

const currentPath = Astro.url.pathname;
const menuId = 'main-navigation-menu';
---

<nav class="site-nav" aria-label="Navegación principal">
  <button
    type="button"
    class="site-nav__toggle"
    aria-expanded="false"
    aria-controls={menuId}
    data-nav-toggle
  >
    <span class="site-nav__toggle-label">Menú</span>
  </button>

  <div class="site-nav__panel" id={menuId} data-nav-panel hidden>
    <ul class="site-nav__list">
      {
        mainNavigation.map((item) => {
          const active = isNavActive(currentPath, item.href);
          return (
            <li class="site-nav__item">
              <a
                href={item.href}
                class:list={['site-nav__link', { 'is-active': active }]}
                aria-current={active ? 'page' : undefined}
                data-nav-link
              >
                {item.label}
              </a>
            </li>
          );
        })
      }
    </ul>
    <div class="site-nav__actions">
      <button
        type="button"
        class="btn btn--secondary site-nav__theme site-nav__theme--panel"
        data-theme-toggle
        aria-label="Cambiar a modo claro"
        title="Cambiar a modo claro"
      >
        Modo claro
      </button>
      <a href={siteConfig.cv.path} class="btn btn--primary site-nav__cv" download>
        CV
      </a>
    </div>
  </div>

  <button
    type="button"
    class="site-nav__theme site-nav__theme--icon"
    data-theme-toggle
    aria-label="Cambiar a modo claro"
    title="Cambiar a modo claro"
  >
    <span class="site-nav__theme-icon site-nav__theme-icon--sun" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="12" r="4"></circle>
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
      </svg>
    </span>
    <span class="site-nav__theme-icon site-nav__theme-icon--moon" aria-hidden="true">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3a7 7 0 0 0 11.5 11.5z"></path>
      </svg>
    </span>
    <span class="sr-only" data-theme-label>Modo claro</span>
  </button>
</nav>
