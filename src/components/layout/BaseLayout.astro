---
import '@/styles/global.css';
import type { ThemeMode } from '@/data/site';
import { siteConfig } from '@/data/site';
import Meta from '@/components/seo/Meta.astro';
import CloudflareAnalytics from '@/components/seo/CloudflareAnalytics.astro';

interface Props {
  title?: string;
  description?: string;
  canonicalPath?: string;
  noindex?: boolean;
}

const {
  title = `${siteConfig.name} — ${siteConfig.role}`,
  description = `${siteConfig.tagline}. Especialidades: ${siteConfig.specialties.join(', ')}.`,
  canonicalPath = '/',
  noindex = false,
} = Astro.props;

const themeDefault: ThemeMode = siteConfig.theme.default;
---

<!doctype html>
<html lang={siteConfig.language} data-theme={themeDefault}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Plus+Jakarta+Sans:wght@600;700&display=swap"
      rel="stylesheet"
    />
    <Meta {title} {description} {canonicalPath} {noindex} />
    <slot name="head" />
    <script is:inline define:vars={{ storageKey: siteConfig.theme.storageKey, defaultTheme: themeDefault }}>
      (function () {
        try {
          var stored = localStorage.getItem(storageKey);
          var theme = stored === 'light' || stored === 'dark' ? stored : defaultTheme;
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          document.documentElement.setAttribute('data-theme', defaultTheme);
        }
      })();
    </script>
    <CloudflareAnalytics />
  </head>
  <body>
    <slot name="skip" />
    <slot />
    <script is:inline src="/scripts/theme.js" defer></script>
    <script is:inline src="/scripts/nav.js" defer></script>
  </body>
</html>
