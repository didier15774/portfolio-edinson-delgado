---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getPublishedCompanies } from '@/data/companies';
import { homeContent } from '@/data/home';

const items = getPublishedCompanies();
if (items.length === 0) {
  return null;
}
---

<section class="section section--alt company-band" aria-labelledby="companies-heading">
  <div class="container">
    <SectionHeading id="companies-heading" title={homeContent.companies.title} />

    <div
      class="company-band__viewport"
      tabindex="0"
      role="region"
      aria-label="Empresas y proyectos con experiencia profesional"
    >
      <ul class="company-band__track" role="list">
        {
          items.map((company) => (
            <li class="company-band__item" role="listitem">
              <div class="company-band__tip" tabindex="0">
                <span class="company-band__tooltip" role="tooltip">{company.name}</span>
                {company.logoSrc ? (
                  <img
                    src={company.logoSrc}
                    alt={company.logoAlt ?? `Logo de ${company.name}`}
                    title={company.name}
                    width={company.logoWidth ?? 720}
                    height={company.logoHeight ?? 220}
                    loading="lazy"
                    decoding="async"
                    class="company-band__logo"
                  />
                ) : (
                  <span class="company-band__name" title={company.name}>{company.name}</span>
                )}
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .company-band__viewport {
    margin-top: var(--space-lg);
    padding-block: var(--space-md);
    padding-top: calc(var(--space-md) + 2.25rem);
    outline: none;
    overflow: visible;
  }

  .company-band__viewport:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
    border-radius: var(--radius-md);
  }

  .company-band__track {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .company-band__item {
    flex: 1 1 0;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 0;
    height: calc(2.75rem + 100px);
  }

  .company-band__tip {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    outline: none;
  }

  .company-band__tooltip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.5rem);
    transform: translateX(-50%) translateY(0.25rem);
    z-index: 5;
    padding: 0.35rem 0.65rem;
    border-radius: var(--radius-sm);
    background: var(--color-navy-900);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    color: var(--color-white);
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    max-width: min(16rem, 90vw);
    overflow: hidden;
    text-overflow: ellipsis;
    pointer-events: none;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--transition-base),
      transform var(--transition-base),
      visibility var(--transition-base);
  }

  .company-band__tooltip::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 0.35rem solid transparent;
    border-top-color: var(--color-navy-900);
  }

  .company-band__tip:hover .company-band__tooltip,
  .company-band__tip:focus-visible .company-band__tooltip {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .company-band__name {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: calc(2.75rem + 100px);
    padding: var(--space-sm);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    text-align: center;
  }

  .company-band__logo {
    display: block;
    width: 100%;
    max-width: calc(9.5rem + 100px);
    height: calc(2.75rem + 100px);
    object-fit: contain;
    object-position: center;
    opacity: 0.72;
    transition: opacity var(--transition-base);
  }

  .company-band__tip:hover .company-band__logo,
  .company-band__tip:focus-within .company-band__logo {
    opacity: 0.95;
  }

  @media (max-width: 767px) {
    .company-band__viewport {
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .company-band__viewport::-webkit-scrollbar {
      display: none;
      width: 0;
      height: 0;
    }

    .company-band__track {
      justify-content: flex-start;
      width: max-content;
      padding-inline: var(--space-md);
      gap: var(--space-xl);
    }

    .company-band__item {
      flex: 0 0 calc(8.5rem + 100px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .company-band__tooltip {
      transition: none;
    }
  }
</style>
