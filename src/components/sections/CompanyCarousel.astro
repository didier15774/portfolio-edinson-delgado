---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { getPublishedCompanies } from '@/data/companies';
import { homeContent } from '@/data/home';

const items = getPublishedCompanies();
if (items.length === 0) {
  return null;
}
---

<section class="section section--alt company-band" aria-labelledby="companies-heading">
  <div class="container">
    <SectionHeading id="companies-heading" title={homeContent.companies.title} />

    <div
      class="company-band__viewport"
      tabindex="0"
      role="region"
      aria-label="Empresas y proyectos con experiencia profesional"
    >
      <ul class="company-band__track" role="list">
        {
          items.map((company) => (
            <li class="company-band__item" role="listitem">
              {company.logoSrc ? (
                <img
                  src={company.logoSrc}
                  alt={company.logoAlt ?? `Logo de ${company.name}`}
                  width={company.logoWidth ?? 160}
                  height={company.logoHeight ?? 48}
                  loading="lazy"
                  decoding="async"
                  class="company-band__logo"
                />
              ) : (
                <span class="company-band__name">{company.name}</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .company-band__viewport {
    margin-top: var(--space-lg);
    padding-block: var(--space-md);
    outline: none;
  }

  .company-band__viewport:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 4px;
    border-radius: var(--radius-md);
  }

  .company-band__track {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg) var(--space-xl);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .company-band__item {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
  }

  .company-band__name {
    display: inline-flex;
    align-items: center;
    min-height: 3rem;
    padding: var(--space-sm) var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    white-space: nowrap;
    transition:
      color var(--transition-base),
      border-color var(--transition-base);
  }

  .company-band__item:hover .company-band__name,
  .company-band__item:focus-within .company-band__name {
    color: var(--color-text-heading);
    border-color: var(--color-accent);
  }

  .company-band__logo {
    display: block;
    height: 2.5rem;
    width: auto;
    max-width: 10rem;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.55;
    transition:
      filter var(--transition-base),
      opacity var(--transition-base);
  }

  .company-band__item:hover .company-band__logo,
  .company-band__item:focus-within .company-band__logo {
    filter: grayscale(0);
    opacity: 1;
  }

  /* Móvil: desplazamiento horizontal táctil, sin barra visible */
  @media (max-width: 767px) {
    .company-band__viewport {
      overflow-x: auto;
      overflow-y: hidden;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
    }

    .company-band__viewport::-webkit-scrollbar {
      display: none;
      width: 0;
      height: 0;
    }

    .company-band__track {
      flex-wrap: nowrap;
      justify-content: flex-start;
      width: max-content;
      padding-inline: var(--space-md);
      gap: var(--space-md);
    }
  }
</style>
