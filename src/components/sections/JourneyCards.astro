---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import { homeContent } from '@/data/home';

const { capabilities } = homeContent;
---

<section class="section section--alt" aria-labelledby="capabilities-heading">
  <div class="container">
    <SectionHeading
      id="capabilities-heading"
      title={capabilities.title}
      subtitle={capabilities.subtitle}
    />
    <div class="grid grid--3">
      {
        capabilities.cards.map((card) => (
          <article class="card journey-card" data-capability={card.id}>
            <h3 class="journey-card__title">{card.title}</h3>
            <p class="card__text">{card.text}</p>
            <Button href={card.href} variant="ghost">Conocer más</Button>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .journey-card__title {
    font-size: var(--text-lg);
    margin-bottom: var(--space-sm);
  }

  .journey-card[data-capability='genexus'] {
    border-top: 3px solid var(--color-blue-500);
  }

  .journey-card[data-capability='modernizacion'] {
    border-top: 3px solid var(--color-orange-500);
  }

  .journey-card[data-capability='innovacion'] {
    border-top: 3px solid var(--color-orange-400);
  }
</style>
