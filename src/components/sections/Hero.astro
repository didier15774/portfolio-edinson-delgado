---
import { siteConfig } from '@/data/site';
import { homeContent } from '@/data/home';
import Button from '@/components/ui/Button.astro';

const { profile } = siteConfig;
---

<section class="hero section--hero" aria-labelledby="hero-heading">
  <div class="container hero__grid">
    <div class="hero__content">
      <p class="hero__name">{siteConfig.tagline}</p>
      <h1 id="hero-heading">{siteConfig.role}</h1>
      <p class="hero__lead">{homeContent.heroLead}</p>
      <div class="hero__chips chip-list" role="list" aria-label="Especialidades">
        {siteConfig.specialties.map((item) => (
          <span class="chip" role="listitem">{item}</span>
        ))}
      </div>
      <div class="hero__actions">
        <Button href="/proyectos/" variant="primary">Ver proyectos</Button>
        <Button href={siteConfig.cv.path} variant="secondary" download={siteConfig.cv.filename}>
          Descargar CV
        </Button>
        <Button href="/contacto/" variant="ghost">Hablemos</Button>
      </div>
    </div>

    <div class="hero__media">
      <picture class="hero__picture">
        <source srcset={profile.image.webp} type="image/webp" />
        <img
          class="hero__photo"
          src={profile.image.jpg}
          alt={profile.image.alt}
          width={profile.image.width}
          height={profile.image.height}
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    </div>
  </div>
</section>

<style>
  .hero__name {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--color-text-heading);
    margin-bottom: var(--space-sm);
  }

  .hero__lead {
    margin-top: var(--space-lg);
    color: var(--color-text-muted);
    max-width: 38rem;
    font-size: var(--text-base);
    line-height: 1.65;
  }
</style>
