---
import Button from '@/components/ui/Button.astro';
import Chip from '@/components/ui/Chip.astro';

interface Props {
  title: string;
  summary: string;
  status: string;
  slug: string;
  technologies?: string[];
}

const { title, summary, status, slug, technologies = [] } = Astro.props;
---

<article class="card project-card">
  <div class="project-card__meta">
    <Chip label={status} />
  </div>
  <h3 class="card__title">
    <a href={`/proyectos/${slug}/`} class="project-card__link">{title}</a>
  </h3>
  <p class="card__text">{summary}</p>
  {
    technologies.length > 0 && (
      <ul class="chip-list project-card__tech" role="list">
        {technologies.slice(0, 5).map((tech) => (
          <li role="listitem">
            <Chip label={tech} />
          </li>
        ))}
      </ul>
    )
  }
  <div class="project-card__action">
    <Button href={`/proyectos/${slug}/`} variant="ghost">Ver caso</Button>
  </div>
</article>

<style>
  .project-card__meta {
    margin-bottom: var(--space-sm);
  }

  .project-card__link {
    color: inherit;
    text-decoration: none;
  }

  .project-card__link:hover {
    color: var(--color-accent-hover);
  }

  .project-card__tech {
    margin: var(--space-md) 0;
  }

  .project-card__action {
    margin-top: var(--space-md);
  }
</style>
