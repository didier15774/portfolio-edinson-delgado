---
import Button from '@/components/ui/Button.astro';
import Chip from '@/components/ui/Chip.astro';

interface ImageItem {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  title: string;
  summary: string;
  status: string;
  slug: string;
  technologies?: string[];
  problem?: string;
  responsibility?: string[];
  coverLabel?: string;
  cover?: ImageItem;
  logo?: ImageItem;
}

const {
  title,
  summary,
  status,
  slug,
  technologies = [],
  problem,
  responsibility = [],
  coverLabel = title,
  cover,
  logo,
} = Astro.props;

const responsibilityText = responsibility.slice(0, 2).join(' · ');
---

<article class="card project-card">
  <div class="project-card__cover">
    {cover ? (
      <img
        class="project-card__cover-img"
        src={cover.src}
        alt={cover.alt}
        width={cover.width}
        height={cover.height}
        loading="lazy"
        decoding="async"
      />
    ) : logo ? (
      <img
        class="project-card__logo"
        src={logo.src}
        alt={logo.alt}
        width={logo.width}
        height={logo.height}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <span class="project-card__cover-label">Portada — {coverLabel}</span>
    )}
  </div>

  <div class="project-card__body">
    {logo && (
      <div class="project-card__brand">
        <img
          class="project-card__logo-inline"
          src={logo.src}
          alt={logo.alt}
          width={logo.width}
          height={logo.height}
          loading="lazy"
          decoding="async"
        />
      </div>
    )}

    <div class="project-card__meta">
      <Chip label={status} />
    </div>
    <h3 class="card__title">
      <a href={`/proyectos/${slug}/`} class="project-card__link">{title}</a>
    </h3>
    <p class="card__text">{summary}</p>

    {
      problem && (
        <div class="project-card__detail">
          <p class="project-card__detail-label">Problema resuelto</p>
          <p class="project-card__detail-text">{problem}</p>
        </div>
      )
    }

    {
      responsibilityText && (
        <div class="project-card__detail">
          <p class="project-card__detail-label">Mi responsabilidad</p>
          <p class="project-card__detail-text">{responsibilityText}</p>
        </div>
      )
    }

    {
      technologies.length > 0 && (
        <ul class="chip-list project-card__tech" role="list">
          {technologies.slice(0, 5).map((tech) => (
            <li role="listitem">
              <Chip label={tech} />
            </li>
          ))}
        </ul>
      )
    }

    <div class="project-card__action">
      <Button href={`/proyectos/${slug}/`} variant="ghost">Ver caso completo</Button>
    </div>
  </div>
</article>

<style>
  .project-card {
    padding: 0;
    overflow: hidden;
  }

  /* ── Zona de portada ── */
  .project-card__cover {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: linear-gradient(
      135deg,
      var(--color-navy-800) 0%,
      rgb(244 122 22 / 0.18) 100%
    );
    border-bottom: 1px solid var(--color-border);
  }

  .project-card__cover-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    /* No ampliar más allá de la resolución original (1600×900) */
    max-width: 1600px;
  }

  /* Fallback: solo logo sin cover */
  .project-card__logo {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: auto;
    height: 2.75rem;
    max-width: 11rem;
    object-fit: contain;
    opacity: 0.9;
  }

  .project-card__cover-label {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    text-align: center;
    white-space: nowrap;
  }

  /* ── Logo inline en el body (cuando hay cover) ── */
  .project-card__brand {
    margin-bottom: var(--space-sm);
  }

  .project-card__logo-inline {
    display: block;
    width: auto;
    height: 1.5rem;
    max-width: 8rem;
    object-fit: contain;
    opacity: 0.75;
    filter: grayscale(1);
  }

  /* ── Body ── */
  .project-card__body {
    padding: var(--space-lg);
  }

  .project-card__meta {
    margin-bottom: var(--space-sm);
  }

  .project-card__link {
    color: inherit;
    text-decoration: none;
  }

  .project-card__link:hover {
    color: var(--color-accent-hover);
  }

  .project-card__detail {
    margin-top: var(--space-md);
  }

  .project-card__detail-label {
    margin: 0 0 var(--space-xs);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-accent);
  }

  .project-card__detail-text {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.55;
  }

  .project-card__tech {
    margin: var(--space-md) 0 0;
  }

  .project-card__action {
    margin-top: var(--space-md);
  }
</style>
