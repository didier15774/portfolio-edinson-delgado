---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Chip from '@/components/ui/Chip.astro';
import Button from '@/components/ui/Button.astro';
import ProjectGallery from '@/components/sections/ProjectGallery.astro';

interface ImageItem {
  src: string;
  alt: string;
  width: number;
  height: number;
}

interface Props {
  title: string;
  summary: string;
  status: string;
  features: string[];
  technologies: string[];
  responsibility: string[];
  results: string[];
  problem?: string;
  solution?: string;
  architecture?: string;
  cover?: ImageItem;
  logo?: ImageItem;
  images?: ImageItem[];
}

const {
  title,
  summary,
  status,
  features,
  technologies,
  responsibility,
  results,
  problem,
  solution,
  architecture,
  cover,
  logo,
  images = [],
} = Astro.props;
---

<article class="section">
  <div class="container container--narrow">
    <nav class="breadcrumb text-muted" aria-label="Ruta de navegación">
      <a href="/proyectos/">Proyectos</a>
      <span aria-hidden="true"> / </span>
      <span aria-current="page">{title}</span>
    </nav>

    {cover && (
      <div class="case-cover">
        <img
          class="case-cover__img"
          src={cover.src}
          alt={cover.alt}
          width={cover.width}
          height={cover.height}
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </div>
    )}

    <header class="case-header">
      {logo && (
        <img
          class="case-header__logo"
          src={logo.src}
          alt={logo.alt}
          width={logo.width}
          height={logo.height}
          loading="lazy"
          decoding="async"
        />
      )}
      <Chip label={status} />
      <h1>{title}</h1>
      <p class="case-header__summary">{summary}</p>
    </header>

    {problem && (
      <section class="case-block">
        <SectionHeading as="h2" title="Problema" />
        <p>{problem}</p>
      </section>
    )}

    {solution && (
      <section class="case-block">
        <SectionHeading as="h2" title="Solución" />
        <p>{solution}</p>
      </section>
    )}

    {responsibility.length > 0 && (
      <section class="case-block">
        <SectionHeading as="h2" title="Responsabilidad" />
        <ul>
          {responsibility.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    {features.length > 0 && (
      <section class="case-block">
        <SectionHeading as="h2" title="Funcionalidades" />
        <ul>
          {features.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    {architecture && (
      <section class="case-block">
        <SectionHeading as="h2" title="Arquitectura" />
        <p>{architecture}</p>
      </section>
    )}

    {technologies.length > 0 && (
      <section class="case-block">
        <SectionHeading as="h2" title="Tecnologías" />
        <ul class="chip-list" role="list">
          {technologies.map((tech) => (
            <li role="listitem"><Chip label={tech} /></li>
          ))}
        </ul>
      </section>
    )}

    {results.length > 0 && (
      <section class="case-block">
        <SectionHeading as="h2" title="Resultados" />
        <ul>
          {results.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    )}

    <ProjectGallery images={images} projectTitle={title} />

    <div class="case-cta">
      <Button href="/contacto/" variant="primary">Contactar sobre un proyecto similar</Button>
    </div>

    <slot />
  </div>
</article>

<style>
  /* ── Portada visual de encabezado ── */
  .case-cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    margin-bottom: var(--space-2xl);
    background: var(--color-bg-elevated);
  }

  .case-cover__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    /* No ampliar más allá de la resolución original (1600×900) */
    max-width: 1600px;
  }

  /* ── Header del caso ── */
  .breadcrumb {
    font-size: var(--text-sm);
    margin-bottom: var(--space-lg);
  }

  .breadcrumb a {
    text-decoration: none;
  }

  .case-header {
    margin-bottom: var(--space-2xl);
  }

  .case-header__logo {
    display: block;
    height: 1.75rem;
    width: auto;
    max-width: 9rem;
    object-fit: contain;
    opacity: 0.7;
    filter: grayscale(1);
    margin-bottom: var(--space-md);
  }

  .case-header h1 {
    margin: var(--space-md) 0;
  }

  .case-header__summary {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  /* ── Bloques de contenido ── */
  .case-block {
    margin-bottom: var(--space-2xl);
  }

  .case-block ul {
    padding-left: 1.25rem;
    color: var(--color-text-muted);
  }

  .case-cta {
    margin-top: var(--space-3xl);
  }
</style>
