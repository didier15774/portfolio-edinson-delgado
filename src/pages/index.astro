---
import PageLayout from '@/layouts/PageLayout.astro';
import Hero from '@/components/sections/Hero.astro';
import AiExecution from '@/components/sections/AiExecution.astro';
import CompanyCarousel from '@/components/sections/CompanyCarousel.astro';
import JourneyCards from '@/components/sections/JourneyCards.astro';
import ProjectCard from '@/components/sections/ProjectCard.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import Recommendations from '@/components/sections/Recommendations.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import JsonLd from '@/components/seo/JsonLd.astro';
import { siteConfig } from '@/data/site';
import { homeContent } from '@/data/home';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order);
---

<PageLayout
  title={`${siteConfig.name} — ${siteConfig.role}`}
  description={homeContent.heroLead}
  canonicalPath="/"
>
  <JsonLd type="Person" slot="head" />
  <Hero />
  <AiExecution />
  <CompanyCarousel />
  <JourneyCards />
  <section class="section">
    <div class="container">
      <SectionHeading
        title={homeContent.projects.title}
        subtitle={homeContent.projects.subtitle}
      />
      <div class="grid grid--2">
        {
          projects.map((project) => (
            <ProjectCard
              title={project.data.title}
              summary={project.data.summary}
              status={project.data.status}
              slug={project.id}
              technologies={project.data.technologies}
              problem={project.data.problem}
              responsibility={project.data.responsibility}
              coverLabel={project.data.title}
            />
          ))
        }
      </div>
      <p style="margin-top: 2rem;">
        <Button href="/proyectos/" variant="secondary">Ver todos los proyectos</Button>
      </p>
    </div>
  </section>
  <Recommendations
    title={homeContent.recommendations.title}
    subtitle={homeContent.recommendations.subtitle}
    maxItems={homeContent.recommendations.maxItems}
  />
  <CtaBanner
    title={homeContent.cta.title}
    text={homeContent.cta.text}
    note={homeContent.cta.note}
    primaryLabel={homeContent.cta.primary.label}
    primaryHref={homeContent.cta.primary.href}
    secondaryLabel={homeContent.cta.secondary.label}
    secondaryHref={homeContent.cta.secondary.href}
  />
</PageLayout>
