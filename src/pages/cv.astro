---
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/ui/Button.astro';
import { siteConfig } from '@/data/site';
---

<PageLayout
  title={`CV — ${siteConfig.name}`}
  description={`Descargar CV de ${siteConfig.name}, Desarrollador GeneXus Senior.`}
  canonicalPath="/cv/"
>
  <section class="section section--hero">
    <div class="container container--narrow">
      <h1>Curriculum vitae</h1>
      <p class="text-muted" style="margin: 1rem 0 2rem;">
        CV actualizado en formato PDF.
      </p>
      <Button href={siteConfig.cv.path} variant="primary" download={siteConfig.cv.filename}>
        Descargar {siteConfig.cv.filename}
      </Button>
    </div>
  </section>
</PageLayout>
