---
import PageLayout from '@/layouts/PageLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import Button from '@/components/ui/Button.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import { aboutContent } from '@/data/about';
import { siteConfig } from '@/data/site';
import { homeContent } from '@/data/home';
---

<PageLayout
  title={`${aboutContent.title} — ${siteConfig.name}`}
  description={aboutContent.intro}
  canonicalPath="/sobre-mi/"
>
  <section class="section section--hero">
    <div class="container container--narrow">
      <SectionHeading as="h1" title={aboutContent.title} subtitle={aboutContent.intro} />
      {
        aboutContent.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))
      }
      <div class="profile-facts">
        <div class="profile-facts__item">
          <span class="profile-facts__label">Ubicación</span>
          <span>{siteConfig.location.label}</span>
        </div>
        <div class="profile-facts__item">
          <span class="profile-facts__label">Disponibilidad</span>
          <span>{siteConfig.availability.label}</span>
        </div>
        <div class="profile-facts__item">
          <span class="profile-facts__label">Experiencia</span>
          <span>20 años en sistemas empresariales</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="container container--narrow">
      <SectionHeading
        title="Ciclo completo de desarrollo"
        subtitle="Experiencia en todas las etapas del ciclo de vida del software."
      />
      <ol class="cycle-list">
        {aboutContent.cycleSteps.map((step) => <li>{step}</li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <SectionHeading title="Especialidades" subtitle="Áreas de trabajo con evidencia en proyectos y experiencia." />
      <ul class="chip-list" role="list">
        {siteConfig.specialties.map((item) => (
          <li role="listitem"><span class="chip">{item}</span></li>
        ))}
      </ul>
      <div class="profile-actions">
        <Button href="/experiencia/" variant="primary">Ver experiencia</Button>
        <Button href={siteConfig.cv.path} variant="secondary" download={siteConfig.cv.filename}>
          Descargar CV
        </Button>
      </div>
    </div>
  </section>

  <CtaBanner
    title={homeContent.cta.title}
    text={homeContent.cta.text}
    primaryLabel={homeContent.cta.primary.label}
    primaryHref={homeContent.cta.primary.href}
    secondaryLabel="Ver servicios"
    secondaryHref="/servicios/"
  />
</PageLayout>

<style>
  .profile-facts {
    display: grid;
    gap: var(--space-md);
    margin-top: var(--space-xl);
    padding: var(--space-lg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
  }

  @media (min-width: 640px) {
    .profile-facts {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .profile-facts__label {
    display: block;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-accent-hover);
    margin-bottom: 0.25rem;
  }

  .cycle-list {
    display: grid;
    gap: var(--space-sm);
    padding-left: 1.25rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 640px) {
    .cycle-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .profile-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }
</style>
