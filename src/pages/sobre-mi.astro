---
import PageLayout from '@/layouts/PageLayout.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { aboutContent } from '@/data/about';
import { siteConfig } from '@/data/site';
---

<PageLayout
  title={`${aboutContent.title} — ${siteConfig.name}`}
  description={aboutContent.intro}
  canonicalPath="/sobre-mi/"
>
  <section class="section section--hero">
    <div class="container container--narrow">
      <SectionHeading as="h1" title={aboutContent.title} subtitle={aboutContent.intro} />
      {
        aboutContent.paragraphs.map((paragraph) => (
          <p>{paragraph}</p>
        ))
      }
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow">
      <SectionHeading
        title="Ciclo completo de desarrollo"
        subtitle="Experiencia en todas las etapas del ciclo de vida del software."
      />
      <ul class="cycle-list">
        {aboutContent.cycleSteps.map((step) => <li>{step}</li>)}
      </ul>
    </div>
  </section>
</PageLayout>

<style>
  .cycle-list {
    display: grid;
    gap: var(--space-sm);
    padding-left: 1.25rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 640px) {
    .cycle-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
