---
import PageLayout from '@/layouts/PageLayout.astro';
import ExperienceTimeline from '@/components/sections/ExperienceTimeline.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import CtaBanner from '@/components/sections/CtaBanner.astro';
import { siteConfig } from '@/data/site';
import { homeContent } from '@/data/home';
---

<PageLayout
  title={`Experiencia profesional — ${siteConfig.name}`}
  description="Trayectoria en Sofis Solutions, Universal Soluciones Tecnológicas y Colmena."
  canonicalPath="/experiencia/"
>
  <section class="section section--hero">
    <div class="container">
      <SectionHeading
        as="h1"
        title="Experiencia"
        subtitle="Más de 20 años en desarrollo de software empresarial, liderazgo técnico y dirección de proyectos."
      />
    </div>
  </section>
  <ExperienceTimeline />
  <CtaBanner
    title={homeContent.cta.title}
    text={homeContent.cta.text}
    primaryLabel={homeContent.cta.primary.label}
    primaryHref={homeContent.cta.primary.href}
    secondaryLabel={homeContent.cta.secondary.label}
    secondaryHref={homeContent.cta.secondary.href}
  />
</PageLayout>
