# Dominio de producción (copiar a .env — .env no se versiona)
PUBLIC_SITE_URL=https://edinson.proyectocolmena.com

# Cloudflare Web Analytics (opcional). Solo se inyecta en build de producción.
# Token del beacon desde el panel Cloudflare → Web Analytics. No es un secreto crítico,
# pero conviene no hardcodearlo en componentes. Ver docs/ANALYTICS_CLOUDFLARE.md
# PUBLIC_CLOUDFLARE_WEB_ANALYTICS_TOKEN=
